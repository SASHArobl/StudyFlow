# Local Supabase: copy API URL and publishable key from `npx supabase status`.
# Required only when a Supabase integration is used; the foundation runs without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Reserved for the later account-deletion increment; never add NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
